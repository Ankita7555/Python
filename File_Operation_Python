15 .Find Invalid Records in a CSV
import csv
with open("employees.csv", "r") as file:
    reader = csv.DictReader(file)

    for row in reader:

        if not row["emp_id"]:
            print("Invalid Employee ID:", row)
            continue

        if not row["name"]:
            print("Invalid Name:", row)
            continue

        if "@" not in row["email"]:
            print("Invalid Email:", row)
            continue

        try:
            salary = float(row["salary"])

            if salary <= 0:
                print("Invalid Salary:", row)

        except ValueError:
            print("Salary is not numeric:", row)

